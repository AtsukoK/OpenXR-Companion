<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>OpenXRCompanionEditor</AssemblyName>
    <RootNamespace>OverviewPrototype</RootNamespace>
    <!-- Bump with every release: the update check compares this with the latest GitHub release tag. -->
    <Version>0.3.2</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- the data side (profiles, bindings, controller layouts...) -->
    <ProjectReference Include="..\core\OpenXRCompanion.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\layer\build\OpenXRCompanion.dll')">
    <!-- the layer DLL next to the editor, as in the real install: the editor asks it to check profiles and key names -->
    <None Include="..\layer\build\OpenXRCompanion.dll" Link="OpenXRCompanion.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/tips/**" />
  </ItemGroup>
</Project>
