<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time tool: traces controller outlines from the WebXR input profile models (MIT) into drawing data
       for the editor and the layer. Not part of the app. See README.md here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
</Project>
