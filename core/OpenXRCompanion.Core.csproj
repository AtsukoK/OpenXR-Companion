<Project Sdk="Microsoft.NET.Sdk">
  <!-- The editor's data side: profiles (load / save), bindings, wheels, controller layouts and outlines, the words for
       actions and tags, presets, and the layer / app-wide files. No window code: used by the WinForms editor and the
       Avalonia editor alike. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenXRCompanionEditor</RootNamespace>
    <AssemblyName>OpenXRCompanion.Core</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
</Project>
